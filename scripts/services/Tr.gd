		"HELP_T_BUILD": "Construir",
		"HELP_B_BUILD": "CONSTRUIR (el botón grande de abajo) abre la lista de edificios. Elige uno y haz clic en el mapa. Los extractores van junto a su yacimiento.",
		"HELP_B_BUILD_TOUCH": "CONSTRUIR (el botón grande de abajo) abre la lista de edificios. Elige uno, toca el mapa y confirma con ✓. Los extractores van junto a su yacimiento.",
		"HELP_T_OBJECTIVE": "Tu objetivo",
		"HELP_B_OBJECTIVE": "Aquí está lo siguiente que conviene hacer. Al cumplirlo sale el próximo.",
		"HELP_T_RESOURCES": "Recursos y almacén",
