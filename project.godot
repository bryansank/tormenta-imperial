; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Tormenta Imperial"
config/description="Hybrid strategy game — persistent base management + RTS combat"
config/version="0.9.0"
run/main_scene="res://scenes/main/Main.tscn"
config/use_custom_user_dir.template=true
config/custom_user_dir_name.template="TormentaImperial"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.05, 0.06, 0.04, 1)
boot_splash/image="res://assets/branding/logo.png"
boot_splash/stretch_mode=0
boot_splash/use_filter=true

[autoload]

Tr="*res://scripts/services/Tr.gd"
GameConfig="*res://scripts/services/GameConfig.gd"
EventBus="*res://scripts/services/EventBus.gd"
InputService="*res://scripts/services/InputService.gd"
GridManager="*res://scripts/grid/GridManager.gd"
ResourceManager="*res://scripts/services/ResourceManager.gd"
GameManager="*res://scripts/services/GameManager.gd"
ProcessManager="*res://scripts/services/ProcessManager.gd"
ProductionManager="*res://scripts/services/ProductionManager.gd"
ProgressionManager="*res://scripts/services/ProgressionManager.gd"
MarketManager="*res://scripts/services/MarketManager.gd"
PopulationManager="*res://scripts/services/PopulationManager.gd"
ArmyManager="*res://scripts/services/ArmyManager.gd"
CombatManager="*res://scripts/services/CombatManager.gd"
RandomEventManager="*res://scripts/services/RandomEventManager.gd"
BuildingHealth="*res://scripts/services/BuildingHealth.gd"
StormManager="*res://scripts/services/StormManager.gd"
StormSky="*res://scripts/map/StormSky.gd"
TechTreeManager="*res://scripts/services/TechTreeManager.gd"
CloudSaveManager="*res://scripts/services/CloudSaveManager.gd"
UIManager="*res://scripts/services/UIManager.gd"
TutorialManager="*res://scripts/services/TutorialManager.gd"
UILayoutManager="*res://scripts/services/UILayoutManager.gd"
AudioManager="*res://scripts/services/AudioManager.gd"
BeckettRuntime="*res://scripts/services/BeckettGate.gd"
DeviceProfile="*res://scripts/services/DeviceProfile.gd"

[beckett]

effort_schema=2
dock_revealed=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[dotnet]

project/assembly_name="TormentaImperial"

[editor_plugins]

enabled=PackedStringArray("res://addons/beckett/plugin.cfg", "res://addons/gdUnit4/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.2, 0.25, 0.2, 1)
