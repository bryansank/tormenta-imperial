# Godot 4 specific
.godot/

# Godot .NET / C#
.mono/
*.csproj.user
*.sln.user

# Build outputs
bin/
obj/
# Exportados del juego (.exe y compañía): se generan, no se versionan. Ver docs/19-exportar.md
/build/

# Import cache (regenerated by editor)
*.import

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
*.code-workspace

# Python cache
__pycache__/
*.pyc

# Crash dumps
*.stackdump

# Environment / secrets
.env
secret.json

# ── Local / personal: nada de esto debe llegar a un repositorio publico ──
#
# Config de clientes MCP: contiene el token local del servidor de Beckett.
# Se regenera sola al abrir el editor.
.mcp.json
.cursor/
.beckett/

# Ajustes por-maquina de Claude Code: rutas absolutas y nombre de usuario.
# El equivalente compartible es .claude/settings.json.
.claude/settings.local.json

# Contexto de negocio y notas personales (estrategia, monetizacion, planes).
# Viven fuera del repositorio, en la carpeta de contexto del autor.
estrategia/
CONTEXTO_PROYECTO.md
NOTAS_*.md
*_PRIVADO.md

# Capturas del recorrido de UI generadas por tools/ui_tour.gd
ui_tour/

# Capturas de verificacion generadas por tools/battle_probe.gd
docs/media/dev/

# Informes de gdUnit4 (se regeneran en cada ejecucion de los tests)
reports/

# Capturas de los flujos de Maestro (qa/maestro/README.md)
qa-out/
# Carpeta de usuario temporal de tools/run_tests.sh (y overrides locales)
/override.cfg
/override.cfg.run_tests.bak
